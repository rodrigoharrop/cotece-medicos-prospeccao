{
  "buildCommand": "echo 'Static deployment'",
  "public": true,
  "routes": [
    {
      "src": "/planilha",
      "dest": "/medicos_prospeccao_completo.html"
    },
    {
      "src": "/download",
      "dest": "/download-planilha.html"
    },
    {
      "src": "/(.*)",
      "dest": "/download-planilha.html"
    }
  ]
}
